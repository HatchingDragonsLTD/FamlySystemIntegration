# Copy to .env and fill in. .env is gitignored -- never commit real values.

# Required: your Famly access token.
FAMLY_ACCESS_TOKEN=your-access-token-here

# Optional: override the GraphQL endpoint.
FAMLY_GRAPHQL_URL=https://app.famly.co/graphql

# Optional: override the REST API base URL (plan create/update lives here).
FAMLY_REST_BASE_URL=https://app.famly.co/api

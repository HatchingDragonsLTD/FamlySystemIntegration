# Copy to .env and fill in. .env is gitignored -- never commit real values.

# Required: your Famly access token.
FAMLY_ACCESS_TOKEN=your-access-token-here

# Optional: override the GraphQL endpoint.
FAMLY_GRAPHQL_URL=https://app.famly.co/graphql

# Optional: override the REST API base URL (plan create/update lives here).
FAMLY_REST_BASE_URL=https://app.famly.co/api

# Required by server.py: the shared secret callers send as X-Intake-Secret.
# The server fails closed (401 on everything) when this is unset.
INTAKE_SHARED_SECRET=change-me

# Optional: plan version the intake passes through to preview (default 3).
INTAKE_PLAN_VERSION=3

# Slack: posting plan previews for approval (integrations/slack.py).
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_CHANNEL_ID=C0000000000

# Slack: verifies inbound button clicks on /slack/interactivity.
# Without it that route rejects every request (fails closed).
SLACK_SIGNING_SECRET=your-signing-secret

# --- Committing plans to Famly -------------------------------------------- #
# The Slack Approve button writes a plan. Two independent gates control it.
#
# Master switch. False (the default) means no commit can happen at all,
# whatever else is set.
COMMIT_ENABLED=false
#
# Child IDs a commit may write to, comma-separated. Empty means no commit can
# proceed. During verification set this to the disposable TEST CHILD ONLY:
#   COMMIT_ALLOWED_CHILD_IDS=00000000-0000-0000-0000-000000000000
# Widen later by adding more IDs. The sentinel * allows every child -- only
# once the path is proven, and knowing it removes the guard entirely.
COMMIT_ALLOWED_CHILD_IDS=

# Where previewed plans are stored so Approve commits exactly what was shown.
# Holds child data; gitignored. Defaults to var/preview_store.sqlite3
PREVIEW_STORE_PATH=
# How long an approval stays valid, in hours (default 24). A click older than
# this is refused rather than committed against stale pricing.
PREVIEW_TTL_HOURS=24
